# Model files over 50 MB. Git can't filter by size, so:
#  - known-large artefacts are listed here, and
#  - scripts/ignore-large-models.sh appends any other model file > 50 MB below the marker.
ml/export/audio-teacher.onnx
ml/checkpoints/
*.ckpt
*.pt
*.pth
*.h5
*.npy
